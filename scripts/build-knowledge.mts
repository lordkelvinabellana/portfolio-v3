/*
 * Builds the knowledge the website chatbot answers from, using the same data
 * the site renders:
 *   public/portfolio-knowledge.json  one entry per section, fetched by the
 *                                    n8n ingest workflow and embedded
 *   content/portfolio-knowledge.md   the same text, for reading
 * Run with:
 *   node --experimental-strip-types --no-warnings scripts/build-knowledge.mts
 * Everything here is already public on the site, so the bot can't say more
 * than the portfolio does.
 */
import { writeFileSync, mkdirSync } from "node:fs";
import { experiencePhases, projectCaseStudies, credentials } from "../src/data/portfolio.ts";
import { services, serviceLabel } from "../src/data/services.ts";

const SITE = "https://portfolio-v3-roan-omega.vercel.app";

type Section = { title: string; url: string; text: string };
const sections: Section[] = [];

/* Each section carries its own heading and context so a chunk still makes
   sense when it's retrieved on its own. */
function section(title: string, url: string, lines: string[]) {
  const text = [`## ${title}`, "", ...lines].join("\n").replace(/—/g, ":").trim();
  sections.push({ title, url, text });
}

section("About Lord Kelvin Abellana", SITE, [
  "Lord Kelvin Abellana (Kelvin) builds the systems that run a business and edits the videos that sell it. Kelvin builds client portals, scorecards, KPI dashboards and onboarding automation (n8n, Make, Next.js, Supabase) for agencies and growing brands, and edits VSLs, short-form ads and testimonials with on-brand motion graphics. Before that, Kelvin grew from Junior Frontend Developer to Lead Frontend Developer to Product Owner at Alphaus, a cloud cost SaaS company, and built startup MVPs with founders at Ardexa.",
  "",
  "- Based in Bohol, Philippines, working remotely.",
  "- Open to client projects and to full-time or contract roles in operations, automation, product and frontend.",
  `- Contact: email lordkelvinabellana@gmail.com, WhatsApp +63 928 558 3697, LinkedIn https://www.linkedin.com/in/lord-kelvin-abellana-46a15a320, contact page ${SITE}/contact.`,
  `- The résumé and full CV can be downloaded from the portfolio (${SITE}).`,
  "- Case study text written as \"I\" is Kelvin describing the work.",
]);

for (const s of services) {
  section(`Service: ${s.title}`, `${SITE}/work?service=${s.key}`, [
    s.summary,
    "",
    ...s.deliverables.map((d) => `- ${d}`),
    `- Proof: ${s.proof}`,
  ]);
}

section("How a project with Kelvin runs", SITE, [
  "1. Brief and audit: Kelvin learns how the work happens today, or what the brand needs to say, before anything is built or cut.",
  "2. Build or cut: the first version of the system, or the first edit, shared early.",
  "3. Prove it: systems run side by side with the old process until the numbers match; edits get a review cut against the brand rules.",
  "4. Hand it over: guides, training and source files, so the team owns what it paid for.",
]);

for (const p of experiencePhases) {
  section(`Experience: ${p.title} (${p.period})`, `${SITE}/experience/${p.slug}`, [
    p.summary,
    "",
    ...p.responsibilities.map((r) => `- ${r}`),
    ...p.achievements.map((a) => `- Achievement: ${a}`),
    ...(p.technologies.length ? [`- Tools: ${p.technologies.join(", ")}`] : []),
  ]);
}

for (const c of projectCaseStudies) {
  section(`Case study: ${c.title}`, `${SITE}/work/${c.slug}`, [
    `Service: ${serviceLabel(c)}${c.status ? `. Status: ${c.status}` : ""}. Kelvin's role: ${c.role}.`,
    "",
    c.overview,
    "",
    `Problem: ${c.businessProblem}`,
    ...c.contributions.map((x) => `- Built: ${x}`),
    ...c.outcomes.map((x) => `- Outcome: ${x}`),
    `- Stack: ${c.stack.join(", ")}`,
    ...(c.demoUrl && c.liveLabel ? [`- Live link: ${c.demoUrl}`] : []),
    `- Case study page: ${SITE}/work/${c.slug}`,
  ]);
}

section("Credentials and certificates", SITE, credentials.map(
  (c) => `- ${c.title}, ${c.issuer}${c.dateEarned ? ` (${c.dateEarned})` : ""}`,
));

mkdirSync("public", { recursive: true });
writeFileSync("public/portfolio-knowledge.json", JSON.stringify(sections, null, 1) + "\n");

mkdirSync("content", { recursive: true });
const md = [
  "# Lord Kelvin Abellana: portfolio knowledge",
  "",
  "The public information the website chatbot answers from. Generated by scripts/build-knowledge.mts; edit src/data instead.",
  "",
  ...sections.map((s) => s.text + "\n"),
].join("\n");
writeFileSync("content/portfolio-knowledge.md", md);

console.log(`wrote ${sections.length} sections (${md.length} chars)`);
